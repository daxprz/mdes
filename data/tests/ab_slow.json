{
  "name": "ab_slow",
  "description": "A/B: slow(2) \u2014 half speed playback",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_slow",
    "strudel ref note(\"c4 d4 e4 f4\").slow(2).pianoroll() cps=0.5",
    "announce REF: slow(2)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: slow(2)",
    "strudel highlights on",
    "strudel edit note(\"c4 d4 e4 f4\").slow(2).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c4|L1:e4]",
    "check strudel highlights check 1/2:[L1:d4|L1:f4]",
    "ab_show ref.wav ours.wav"
  ]
}
