{
  "name": "ab_hpf",
  "description": "A/B: sawtooth with HPF at 800Hz",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_hpf",
    "strudel ref note(\"c4 c4 c4 c4\").s(\"sawtooth\").hpf(800).pianoroll() cps=0.5",
    "announce REF: sawtooth + hpf(800)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: sawtooth + hpf(800)",
    "strudel edit note(\"c4 c4 c4 c4\").s(\"sawtooth\").hpf(800).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "ab_show ref.wav ours.wav",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500"
  ]
}
