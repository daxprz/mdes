{
	"name": "chained_leap_bounds",
	"script": [
		"var owait default=0",
		"debug on chain/tether_arc",
		"debug on chain/chain_barrier",
		"debug on precog/graph_edges",
		"debug on testing/planned_leaps",
		"debug log precog/current_path",
		"level title_screen",
		"wait 0.2",
		"clear",
		"portal off",
		"clearplayers",
		"spawn monster 1400 885 standdown",
		"wait 1",
		"chain 0 head wall 1920 820 700",
		"spawn dummy 960 885",
		"standdown off",
		"# Monster hunts the ball — breach fences mark the chain boundary",
		"# Chain anchor (1920,820) with len 700 means monster must stay within ~700px of that point",
		"# Left boundary: 1920 - 700 = 1220, but allow some slack for body width",
		"wait 15 unless exit_circle 960 885 34 dummy*",
		"standdown on",
		"debug off chain/tether_arc",
		"debug off chain/chain_barrier",
		"debug off precog/graph_edges",
		"debug off testing/planned_leaps",
		"debug nolog precog/current_path",
		"debug on testing/violations",
		"check no_leaps label:chain_blocks_leap",
		"check hp extract:damage_taken = 0.0 label:no_damage",
		"check fps extract:fps > 20.0 label:fps",
		"notify observations DONE [\"OK\"] {owait} editor"
	]
}