{
  "name": "exec_shackle_drag",
  "description": "Shackle leash: AI shackles ball, walks far away. Verify ball follows player within chain distance.",
  "debug": {
    "log": ["executioner/throw", "executioner/chain_radius"],
    "on": ["executioner/chain_radius"]
  },
  "script": [
    "level flat_floor",
    "wait 0.3",
    "clear",
    "portal off",
    "clearplayers",
    "debug on executioner/chain_radius",
    "debug log executioner/chain_radius",

    "announce Shackle Drag Test",
    "ai_spawn 640 876 class=executioner name=AI",
    "wait 0.5",
    "spawn dummy 840 876 name=ball",
    "wait 0.5",

    "announce Force-attaching shackle (no ball throw — player is free to walk)",
    "shackle_attach ball",
    "wait 1",

    "announce Verify: ball must stay within 350px of AI at all times",
    "verify @e[name=ball] within circle @e[name=AI] 350 until done",

    "announce AI walks far right",
    "ai_cmd move_right 5.0",
    "wait 6",

    "announce AI walks far left",
    "ai_cmd move_left 6.0",
    "wait 7",

    "announce AI walks right again",
    "ai_cmd move_right 4.0",
    "wait 5",

    "ai_off",
    "enablejoins",
    "notify observations exec_shackle_drag [\"OK\",\"RETRY\"] 0 editor"
  ]
}
