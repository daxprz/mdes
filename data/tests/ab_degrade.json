{
  "name": "ab_degrade",
  "description": "A/B: degrade c4? \u2014 random note drops",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_degrade",
    "strudel ref note(\"c4 d4 e4 f4 g4 a4 b4 c5\").degrade().pianoroll() cps=0.5",
    "announce REF: scale with degrade",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: scale with degrade",
    "strudel highlights on",
    "strudel edit note(\"c4 d4 e4 f4 g4 a4 b4 c5\").degrade().pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.10 0.8 500 0",
    "check strudel highlights check 0/1:[L1:c4]",
    "check strudel highlights check 1/8:[L1:d4]",
    "check strudel highlights check 1/4:[L1:e4]",
    "check strudel highlights check 3/8:[L1:f4]",
    "check strudel highlights check 1/2:[L1:g4]",
    "check strudel highlights check 7/8:[L1:c5]",
    "ab_show ref.wav ours.wav"
  ]
}
