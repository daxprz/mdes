{
  "name": "ab_legato",
  "description": "A/B: legato(0.5) — half-duration staccato notes",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "strudel cps 0.5",
    "wait 1",
    "ab_dir ab_legato",

    "# Reference: note pattern with legato(0.5)",
    "strudel ref begin",
    "note(\"c4 e4 g4 c5\").legato(0.5)",
    "strudel ref end",
    "announce REF: legato(0.5)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",

    "# Ours: identical code",
    "announce OURS: legato(0.5)",
    "strudel highlights on",
    "strudel edit note(\"c4 e4 g4 c5\").legato(0.5) cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c4]",
    "check strudel highlights check 1/4:[L1:e4]",
    "check strudel highlights check 1/2:[L1:g4]",
    "check strudel highlights check 3/4:[L1:c5]",
    "ab_show ref.wav ours.wav"
  ]
}
