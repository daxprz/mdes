{
  "name": "ab_triangle",
  "description": "A/B: triangle wave C4",
  "script": [
    "strudel stop",
    "music off",
    "ab_dir ab_triangle",

    "strudel ref note(\"c4\",\"c4\",\"c4\",\"c4\").s(\"triangle\")",
    "announce REF: triangle C4",
    "ab_play ref.wav",
    "wait 10 unless silent",

    "announce OURS: triangle C4",
    "strudel record start",
    "strudel edit \"c4 c4 c4 c4\".s(\"triangle\").pianoroll() cps=0.5",
    "wait 10 unless silent",
    "strudel stop",
    "music off",
    "strudel record stop ours",

    "ab_show ref.wav ours.wav",
    "check ab_compare ref.wav ours.wav 0.05 0.5"
  ]
}
