{
  "name": "ab_jux",
  "description": "A/B: jux(rev) \u2014 reversed copy superimposed",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_jux",
    "strudel ref note(\"c4 e4 g4 c5\").jux(rev).pianoroll() cps=0.5",
    "announce REF: jux(rev)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: jux(rev)",
    "strudel highlights on",
    "strudel edit note(\"c4 e4 g4 c5\").jux(rev).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0.7",
    "check strudel highlights check 0/1:[L1:c4|L1:c5]",
    "ab_show ref.wav ours.wav"
  ]
}
