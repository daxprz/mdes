{
  "name": "ab_euclid_5_13",
  "description": "A/B: euclidean (5,13) \u2014 complex rhythm",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_euclid_5_13",
    "strudel ref note(\"c4\").euclid(5,13).pianoroll() cps=0.5",
    "announce REF: euclid(5,13)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: euclid(5,13)",
    "strudel edit note(\"c4\").euclid(5,13).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "ab_show ref.wav ours.wav"
  ]
}
