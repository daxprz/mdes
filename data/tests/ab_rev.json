{
  "name": "ab_rev",
  "description": "A/B: rev() \u2014 reversed pattern",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_rev",
    "strudel ref note(\"c4 d4 e4 f4 g4 a4 b4 c5\").rev().pianoroll() cps=0.5",
    "announce REF: rev()",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: rev()",
    "strudel highlights on",
    "strudel edit note(\"c4 d4 e4 f4 g4 a4 b4 c5\").rev().pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c5]",
    "check strudel highlights check 1/8:[L1:b4]",
    "check strudel highlights check 1/4:[L1:a4]",
    "check strudel highlights check 3/8:[L1:g4]",
    "ab_show ref.wav ours.wav"
  ]
}
