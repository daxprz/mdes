{
  "name": "ab_fast",
  "description": "A/B: fast tempo cps=2",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_fast",
    "strudel ref note(\"c4 d4 e4 f4 g4 a4 b4 c5\").pianoroll() cps=0.5",
    "announce REF: scale at default cps",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: scale at cps=0.5",
    "strudel highlights on",
    "strudel edit note(\"c4 d4 e4 f4 g4 a4 b4 c5\").pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c4]",
    "check strudel highlights check 1/8:[L1:d4]",
    "check strudel highlights check 1/4:[L1:e4]",
    "check strudel highlights check 3/8:[L1:f4]",
    "ab_show ref.wav ours.wav"
  ]
}
