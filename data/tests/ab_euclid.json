{
  "name": "ab_euclid",
  "description": "A/B: euclidean rhythm (3,8)",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_euclid",
    "strudel ref note(\"c4\").euclid(3,8).pianoroll() cps=0.5",
    "announce REF: euclidean (3,8)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: euclidean (3,8)",
    "strudel edit note(\"c4\").euclid(3,8).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "wait 1",
    "strudel record stop ours",
    "ab_show ref.wav ours.wav",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500"
  ]
}
