{
  "name": "exag_gait_oscillation",
  "description": "Monster chases dummy back and forth at floor level. Exercises leg gait oscillation and depth ordering.",
  "script": [
    "var inspect default=false",
    "var owait default=0",
    "level flat_floor",
    "wait 0.2",
    "clear",
    "portal off",
    "clearplayers",
    "spawn monster 960 885 standdown scale=1.5 config={gait_knee_swing=25.0,gait_stride_rate=0.15,turn_speed=3.0,accel_rate=100.0,decel_rate=400.0,stiffness=6.0,speed_slow=15.0,speed_medium=35.0,speed_fast=60.0}",
    "spawn dummy 400 885",
    "debug on body_mechanics/leg_debug",
    "debug on body_mechanics/spine_debug",
    "debug on state_info/state_text_panel",
    "tab",
    "standdown off",
    "wait 3",
    "tp 1600 885",
    "wait 3",
    "tp 400 885",
    "wait 3",
    "tp 1600 885",
    "wait 3",
    "tp 400 885",
    "wait 3",
    "tp 1600 885",
    "wait 3",
    "standdown on",
    "debug off body_mechanics/leg_debug",
    "debug off body_mechanics/spine_debug",
    "debug off state_info/state_text_panel",
    "check fps extract:fps > 20.0",
    "notify observations DONE [\"OK\"] {owait} editor"
  ]
}
