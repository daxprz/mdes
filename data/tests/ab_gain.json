{
  "name": "ab_gain",
  "description": "A/B: gain control \u2014 loud then quiet",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_gain",
    "strudel ref note(\"c4\",\"c4\",\"c4\",\"c4\").gain(0.3)",
    "announce REF: gain 0.3",
    "ab_play ref.wav",
    "wait 10 unless silent",
    "announce OURS: gain 0.3",
    "strudel edit \"c4 c4 c4 c4\".gain(0.3).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "ab_show ref.wav ours.wav",
    "check ab_compare ref.wav ours.wav 0.05 0.5 10"
  ]
}
