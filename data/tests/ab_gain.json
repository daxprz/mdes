{
  "name": "ab_gain",
  "description": "A/B: gain control \u2014 loud then quiet",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_gain",
    "strudel ref note(\"c4 c4 c4 c4\").gain(0.3).pianoroll() cps=0.5",
    "announce REF: gain 0.3",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: gain 0.3",
    "strudel edit note(\"c4 c4 c4 c4\").gain(0.3).pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "ab_show ref.wav ours.wav"
  ]
}
