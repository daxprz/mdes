{
  "name": "ab_square",
  "description": "A/B: square wave C4",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_square",
    "strudel ref note(\"c4 c4 c4 c4\").s(\"square\").pianoroll() cps=0.5",
    "announce REF: square C4",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: square C4",
    "strudel highlights on",
    "strudel edit note(\"c4 c4 c4 c4\").s(\"square\").pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c4]",
    "check strudel highlights check 1/4:[L1:c4]",
    "check strudel highlights check 1/2:[L1:c4]",
    "check strudel highlights check 3/4:[L1:c4]",
    "ab_show ref.wav ours.wav"
  ]
}
