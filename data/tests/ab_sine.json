{
  "name": "ab_sine",
  "description": "A/B: sine wave C4",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_sine",
    "strudel ref note(\"c4 c4 c4 c4\").pianoroll() cps=0.5",
    "announce REF: sine C4",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: sine C4",
    "strudel edit note(\"c4 c4 c4 c4\").pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "ab_show ref.wav ours.wav"
  ]
}
