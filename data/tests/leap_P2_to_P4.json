{
	"name": "leap_P2_to_P4",
	"script": [
		"var observations_wait default=5",
		"debug on precog/platform_list",
		"debug on precog/graph_edges",
		"debug on testing/planned_leaps",
		"debug on testing/bounded_leap_checks",
		"debug on testing/etz_daz_zones",
		"debug log precog/current_path",
		"clear",
		"portal off",
		"clearplayers",
		"clearzones",
		"spawn monster 1350 730 standdown",
		"spawn dummy 1250 525",
		"bleap reset",
		"bleap a 1380 750 50",
		"bleap b 1251 527 50",
		"bleap plan opt start 1391 731 200 39 end 1251 525 142 disallow 25 1364 554 1363 746",
		"bleap min 1",
		"standdown off",
		"wait 20 unless breach 1308 556 1308 748 monster* dummy* unless exit_circle 1250 525 27 dummy*",
		"standdown on",
		"debug off precog/platform_list",
		"debug off precog/graph_edges",
		"debug off testing/planned_leaps",
		"debug off testing/bounded_leap_checks",
		"debug off testing/etz_daz_zones",
		"debug nolog precog/current_path",
		"debug on testing/violations",
		"check hp extract:damage_taken > 0.0 label:damage",
		"check fps extract:fps > 20.0",
		"check bounded_leaps P2-to-P4 leap arc",
		"notify observations DONE [\"OK\"] {observations_wait} editor"
	]
}