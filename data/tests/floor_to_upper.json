{
  "name": "floor_to_upper",
  "script": [
    "var inspect default=0",
    "var owait default=0",
    "level title_screen",
    "wait 0.2",
    "clear",
    "portal off",
    "clearplayers",
    "spawn dummy 670 525",
    "spawn monster 960 885",
    "wait 15 unless breach 598 540 677 450 dummy* unless breach 638 453 736 549 dummy* unless breach 634 886 636 768 monster* dummy*",
    "standdown on",
    "debug on testing/violations",
    "check hp extract:damage_taken > 0.0 label:damage",
    "check fps extract:fps > 20.0",
    "check ik extract:ik_peak < 2000.0 label:ik_peak",
    "notify {SCRIPT} \"How does {SCRIPT} look?\" [\"OK\",\"BAD\",\"BROKEN\"] {inspect} blocking"
  ]
}
