{
  "name": "class_ninja_basics",
  "description": "Basic movement + combat test for ninja: spawn, walk, jump, attack, special",
  "script": [
    "var inspect default=0",
    "level flat_floor",
    "wait 0.3",
    "clear",
    "portal off",
    "clearplayers",
    "",
    "announce NINJA \u2014 Basic Movement + Combat",
    "ai_spawn 960 876 class=ninja name=AI",
    "wait 0.5",
    "",
    "# Walk right",
    "announce Walking right",
    "ai_cmd move_right 1.0",
    "wait 1.5",
    "",
    "# Attack while walking right",
    "announce Attacking",
    "ai_cmd attack 0.1",
    "wait 0.3",
    "ai_cmd attack 0.1",
    "wait 0.3",
    "ai_cmd attack 0.1",
    "wait 0.5",
    "",
    "# Jump",
    "announce Jumping",
    "ai_cmd jump 0.1",
    "wait 0.8",
    "",
    "# Walk left and attack",
    "announce Walking left + attacking",
    "ai_cmd move_left 0.5",
    "wait 0.5",
    "ai_cmd attack 0.1",
    "wait 0.5",
    "",
    "# Special ability",
    "announce Special ability",
    "ai_cmd special 0.1",
    "wait 1.0",
    "",
    "# Walk right, jump, attack in air",
    "announce Air attack",
    "ai_cmd move_right 0.3",
    "wait 0.3",
    "ai_cmd jump 0.1",
    "wait 0.2",
    "ai_cmd attack 0.1",
    "wait 1.0",
    "",
    "ai_off",
    "enablejoins",
    "notify {SCRIPT} \"How does {SCRIPT} look?\" [\"OK\",\"BAD\",\"BROKEN\"] {inspect} blocking"
  ]
}
