{
	"name": "gait_tuning_loop",
	"description": "Peaceful monster walks back and forth on a flat floor forever. For tuning gait parameters with sliders.",
	"script": [
		"var owait default=0",
		"var looping default=true",
		"clear",
		"portal off",
		"clearplayers",
		"spawn monster 960 885 standdown scale=1.5 config={peaceful=1,gait_knee_swing=20.0,gait_stride_rate=0.12,turn_speed=3.0,accel_rate=120.0,decel_rate=400.0,stiffness=8.0,speed_slow=40.0,speed_medium=80.0,speed_fast=140.0}",
		"spawn dummy 300 885",
		"debug on body_mechanics/leg_debug",
		"debug on body_mechanics/spine_debug",
		"debug on state_info/state_text_panel",
		"tab",
		"standdown off",
		"while {looping}",
		"wait 5",
		"tp 1700 885",
		"wait 5",
		"tp 300 885",
		"endwhile",
		"standdown on",
		"check fps extract:fps > 20.0",
		"notify observations DONE [\"OK\"] {owait} editor"
	]
}
