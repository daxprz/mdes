{
  "name": "same_floor_far",
  "script": [
    "var inspect default=false",
    "var owait default=0",
    "level title_screen",
    "wait 0.2",
    "clear",
    "portal off",
    "clearplayers",
    "spawn dummy 200 885",
    "spawn monster 960 885",
    "wait 15 unless exit_circle 200 885 38 dummy*",
    "standdown on",
    "debug on testing/violations",
    "check hp extract:damage_taken > 0.0 label:damage",
    "check fps extract:fps > 20.0",
    "check ik extract:ik_peak < 2000.0 label:ik_peak",
    "notify observations DONE [\"OK\"] {owait} editor"
  ]
}
