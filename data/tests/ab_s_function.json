{
  "name": "ab_s_function",
  "description": "A/B: s() top-level function \u2014 cycling waveforms",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "wait 1",
    "ab_dir ab_s_function",
    "strudel ref s(\"sawtooth square triangle sine\").pianoroll() cps=0.5",
    "announce REF: s() waveform cycle",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",
    "announce OURS: s() waveform cycle",
    "strudel highlights on",
    "strudel edit s(\"sawtooth square triangle sine\").pianoroll() cps=0.5",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.10 0.5 500 0",
    "check strudel highlights check 0/1:[L1:sawtooth]",
    "check strudel highlights check 1/4:[L1:square]",
    "check strudel highlights check 1/2:[L1:triangle]",
    "check strudel highlights check 3/4:[L1:sine]",
    "ab_show ref.wav ours.wav"
  ]
}
