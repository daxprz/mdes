{
	"name": "leap_floor_to_P2",
	"script": [
		"var observations_wait default=5",
		"debug on precog/platform_list",
		"debug on precog/graph_edges",
		"debug on precog/status_text",
		"debug on testing/planned_leaps",
		"debug on testing/bounded_leap_checks",
		"debug on leap_attack/chosen_arc",
		"debug log precog/current_path",
		"debug log leap_attack/rays_cast",
		"debug log pathing/platform_leap_path",
		"clear",
		"portal off",
		"clearplayers",
		"clearzones",
		"spawn monster 1300 885 standdown",
		"spawn dummy 1402 740",
		"bleap reset",
		"bleap a 960 885 49",
		"bleap b 1380 750 30",
		"bleap plan opt start 1597 858 165 46 end 1380 750 209 disallow 16 1577 778 1580 900",
		"bleap plan opt start 875 858 301 46 end 1380 750 209 disallow 16 1188 769 1192 898",
		"bleap min 1",
		"standdown off",
		"wait 20 unless breach 881 890 1070 495 monster* dummy* unless breach 1628 476 1920 790 monster* dummy* unless breach 1076 491 1626 473 monster* dummy* unless exit_circle 1401 742 33 dummy*",
		"standdown on",
		"debug off precog/platform_list",
		"debug off precog/graph_edges",
		"debug off precog/status_text",
		"debug off testing/planned_leaps",
		"debug off testing/bounded_leap_checks",
		"debug off leap_attack/chosen_arc",
		"debug nolog precog/current_path",
		"debug nolog leap_attack/rays_cast",
		"debug nolog pathing/platform_leap_path",
		"debug on testing/violations",
		"check hp extract:damage_taken > 0.0 label:damage",
		"check fps extract:fps > 20.0",
		"check bounded_leaps floor-to-P2 leap arc",
		"notify observations DONE [\"OK\"] {observations_wait} editor"
	]
}