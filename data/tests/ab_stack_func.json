{
  "name": "ab_stack_func",
  "description": "A/B: multi-line stacking — identical code to both ref and ours",
  "script": [
    "ab_dismiss",
    "strudel stop",
    "music off",
    "strudel cps 0.5",
    "wait 1",
    "ab_dir ab_stack_func",

    "# Reference: multi-line block sent to real Strudel (default CPS=0.5)",
    "strudel ref begin",
    "stack(",
    "  note(\"c4 e4 g4 c5\"),",
    "  note(\"c2 ~ c2 ~\")",
    ")",
    "strudel ref end",
    "announce REF: stack(melody, bass)",
    "ab_play ref.wav",
    "wait 10 unless silent 2.5",

    "# Ours: same multi-line block to our drawer",
    "announce OURS: stack(melody, bass)",
    "strudel highlights on",
    "strudel begin",
    "stack(",
    "  note(\"c4 e4 g4 c5\"),",
    "  note(\"c2 ~ c2 ~\")",
    ")",
    "strudel end",
    "strudel record start",
    "wait 10 unless silent 2.5",
    "strudel stop",
    "music off",
    "strudel record stop ours",
    "check ab_compare ref.wav ours.wav 0.05 0.5 500 0",
    "check strudel highlights check 0/1:[L1:c4|L1:c2]",
    "check strudel highlights check 1/4:[L1:e4]",
    "check strudel highlights check 1/2:[L1:g4|L1:c2]",
    "check strudel highlights check 3/4:[L1:c5]",
    "ab_show ref.wav ours.wav"
  ]
}
