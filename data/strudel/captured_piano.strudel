  melody: note("<[~ ~ e5 ~] [cs6 ~ a5 ~] [cs6 a5 e5 cs6] [cs6 [a5,e5] b5 [e5,a5]]>").s("piano").decay(2).sustain(0.2).release(3).gain(0.3),
