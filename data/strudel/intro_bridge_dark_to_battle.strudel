// Bridge: Dark → Battle — one cycle, minor sustain into driving tension
setcps(0.30)

stack(
  sub: note("[c2 eb2 g2 c2]").s("sine").gain(0.10).legato(1.0),
  pad: note("[[c3,eb3,g3] [c3,eb3,g3] [c3,eb3,g3] [c3,eb3,g3]]").s("sine").gain(0.07).legato(1.0),
  mid: note("[[eb4,g4] [eb4,g4] [eb4,g4] [eb4,g4]]").s("sine").gain(0.035).legato(0.8),
  sparkle: note("eb5 g5 c6 eb6 g5 c6 eb6 g6").fast(2).s("sine").gain(0.02).legato(0.2),
  shimmer: note("eb6 ~ g5 ~ c6 ~ eb6 ~").s("sine").gain(0.015).legato(0.15),
  pulse: note("c2 ~ eb3 ~ c3 ~ g2 c3").s("sine").gain(0.04).legato(0.15)
)
