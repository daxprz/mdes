// Bridge: Light → Dark — one cycle, descending into minor
setcps(0.175)

stack(
  sub: note("[c2 c2 eb2 c2]").s("sine").gain(0.13).legato(1.2),
  pad: note("[[c3,e3,g3] [c3,eb3,g3] [c3,eb3,ab3] [c3,eb3,g3]]").s("sine").gain(0.08).legato(1.0),
  mid: note("[[e4,g4] [eb4,g4] [eb4,ab4] [eb4,g4]]").s("sine").gain(0.045).legato(0.8),
  sparkle: note("g5 e6 eb6 c6 g5 eb5 c5 bb4").fast(2).s("sine").gain(0.025).legato(0.2),
  shimmer: note("e6 ~ eb6 ~ c6 ~ bb5 ~").s("sine").gain(0.018).legato(0.15),
  pulse: note("c3 ~ g3 ~ c3 ~ ~ eb3").s("sine").gain(0.05).legato(0.15)
)
