# Godot
.godot/
*.translation

# Machine-local ccc-bd symlink (points at this host's CCC workspace bin)
/bin/ccc-bd

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Generated scripts (can regenerate from source)
generate_sprites.py
generate_sounds.py

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log

# Build exports
build/
export/

# Mocap tool output + model (large binary)
tools/mocap/output/*.json
tools/mocap/pose_landmarker_full.task

# Beads work-graph DB (per-machine, lives at /var/<project>/beads/)
.beads/

# Agent memory (per-machine / per-user, not shared via version control)
.claude/agent-memory/

# Local Godot project-setting overrides (per-machine, e.g. windowed mode for RDP)
/override.cfg
