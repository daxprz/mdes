{
  "permissions": {
    "allow": [
      "// ============================================================",
      "// CORE TOOLS",
      "// ============================================================",
      "Edit",
      "Read",
      "WebFetch(domain:docs.godotengine.org)",
      "WebFetch(domain:julienduranleau-sandbox.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch",
      "Write",
      "// ============================================================",
      "// BASH - File System",
      "// ============================================================",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(open *)",
      "Bash(printf *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "// ============================================================",
      "// BASH - Process & System",
      "// ============================================================",
      "Bash(osascript *)",
      "Bash(pkill *)",
      "Bash(ps *)",
      "Bash(sleep *)",
      "// ============================================================",
      "// BASH - Git",
      "// ============================================================",
      "Bash(gh api *)",
      "Bash(git *)",
      "// ============================================================",
      "// BASH - Godot",
      "// ============================================================",
      "Bash(/Applications/Godot.app/Contents/MacOS/Godot *)",
      "Bash(/usr/local/bin/godot *)",
      "Bash(/usr/bin/godot *)",
      "Bash(godot *)",
      "// ============================================================",
      "// BASH - RCON (game communication)",
      "// ============================================================",
      "Bash(nc -w1 localhost 9999)",
      "Bash(nc -w2 localhost 9999)",
      "Bash(nc -w3 localhost 9999)",
      "// ============================================================",
      "// BASH - Test Scripts",
      "// ============================================================",
      "Bash(bash .claude/scripts/*)",
      "Bash(bash scripts/*)",
      "Bash(scripts/run_test.sh *)",
      "Bash(scripts/run_suites.sh *)",
      "// ============================================================",
      "// BASH - Python & Tools",
      "// ============================================================",
      "Bash(python3 *)",
      "Bash(tools/mocap/run.sh)",
      "// ============================================================",
      "// MCP OLAI - System",
      "// ============================================================",
      "mcp__olai__context",
      "mcp__olai__ping",
      "mcp__olai__whoami",
      "// ============================================================",
      "// MCP OLAI - ORN & Path Utilities",
      "// ============================================================",
      "mcp__olai__corpora",
      "mcp__olai__orn",
      "mcp__olai__target_to_orn",
      "mcp__olai__target_to_resource_orn",
      "// ============================================================",
      "// MCP OLAI - Resource Management",
      "// ============================================================",
      "mcp__olai__resource_actualize",
      "mcp__olai__resource_ancestors",
      "mcp__olai__resource_containers",
      "mcp__olai__resource_discover",
      "mcp__olai__resource_get",
      "mcp__olai__resource_info",
      "mcp__olai__resource_ingest_canonize",
      "mcp__olai__resource_ingest_provision",
      "mcp__olai__resource_ingest_suggestions",
      "mcp__olai__resource_instantiate",
      "mcp__olai__resource_move",
      "// ============================================================",
      "// MCP OLAI - Variant Management",
      "// ============================================================",
      "mcp__olai__llm_file",
      "mcp__olai__variant_dashboard",
      "mcp__olai__variant_file",
      "mcp__olai__variants",
      "// ============================================================",
      "// MCP OLAI - Scan & PDF Tools",
      "// ============================================================",
      "mcp__olai__pdf_auto_split",
      "mcp__olai__pdf_classify_pages",
      "mcp__olai__scan_complete",
      "mcp__olai__scan_markdown",
      "mcp__olai__scan_pages",
      "mcp__olai__convert_email_to_markdown",
      "mcp__olai__convert_markdown_to_pdf",
      "// ============================================================",
      "// MCP OLAI - Knowledge Exchange",
      "// ============================================================",
      "mcp__olai__knowledge_manifest",
      "mcp__olai__knowledge_read",
      "mcp__olai__knowledge_propose",
      "mcp__olai__knowledge_status",
      "Bash(cp /var/tumu/aid/sessions/*)",
      "Bash(mv /var/tumu/aid/sessions/*)",
      "Bash(nc -z localhost 6005)",
      "Bash(nc -w5 localhost 9999)",
      "Bash(nc -w10 localhost 9999)",
      "Bash(afplay *)",
      "Bash(SwitchAudioSource *)",
      "Bash(kill %1)",
      "Bash(gh search *)",
      "Bash(gh pr *)",
      "Bash(gh release *)",
      "Bash(xargs kill *)",
      "Bash(sips *)",
      "Bash(screencapture -x /tmp/wb_verify_normal_cp.png)",
      "Bash(screencapture -x /tmp/wb_diagram.png)",
      "Bash(tmux list-sessions *)",
      "Bash(/opt/homebrew/bin/tmux capture-pane *)"
    ],
    "deny": [
      "**/.git/**",
      "**/.godot/**",
      "**/.import/**",
      "**/build/**"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/tidy-settings.py\"",
            "statusMessage": "Tidying settings..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "godot-lsp@tumu-plugins": true
  },
  "extraKnownMarketplaces": {
    "tumu-plugins": {
      "source": {
        "source": "directory",
        "path": "/var/tumu/workspace/.claude/plugins"
      }
    }
  }
}
